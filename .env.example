# === Homelab Security AI — Beispielkonfiguration ===
# Kopiere nach .env und fülle Werte.
# NIEMALS .env ins Repo committen!

BIND_HOST=0.0.0.0
DASHBOARD_PORT=8080
WEBHOOK_PORT=5000

SECRET_KEY=bitte-einen-langen-zufaelligen-string-generieren
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=bitte-ein-starkes-passwort-setzen
WEBHOOK_TOKEN=bitte-einen-langen-zufaelligen-token-setzen

GUEST_NETWORK_PREFIX=192.168.189.
# Fritz!Box-Watcher (Phase 3.8a). Alle vier Pflicht.
# FRITZ_NETWORK_TYPE Default: Hauptnetz.
FRITZ_HOST=192.168.178.1
FRITZ_USERNAME=
FRITZ_PASSWORD=
FRITZ_NETWORK_TYPE=Hauptnetz

PROXMOX_URL=https://192.168.178.114:8006/api2/json
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NETWORK_WATCH_ENABLED=true
SNIFF_IFACE=eth0
PORTSCAN_THRESHOLD_PORTS=20
PORTSCAN_THRESHOLD_WINDOW=10
PORTSCAN_THRESHOLD_IPS=10
PORTSCAN_THRESHOLD_IPS_WINDOW=30

OLLAMA_BASE_URL=http://127.0.0.1:11434
SECURITY_AI_MODEL=llama3.2:3b
SECURITY_AI_MODEL_LARGE=qwen2.5:7b

ADMIN_AI_PROVIDER=none
ADMIN_AI_MODEL=
ADMIN_AI_API_KEY=
