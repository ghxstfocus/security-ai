# Security AI — Umgebungsvariablen (Beispiel).
#
# Kopiere diese Datei nach .env und passe die Werte an.
# .env ist in .gitignore und wird nicht versioniert.

# --- Telegram (Alarm-Pfad) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ollama (lokale KI) ---
# Adresse des Ollama-Servers. Default: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default-Modell (schnell, fuer Chat/Erklaerungen).
# Empfehlung CPU-only: llama3.2:3b
SECURITY_AI_MODEL=llama3.2:3b

# Grosses Modell (langsam, fuer tiefe Fragen).
# Empfehlung CPU-only nur bei Bedarf nutzen: qwen2.5:7b
SECURITY_AI_MODEL_LARGE=qwen2.5:7b
