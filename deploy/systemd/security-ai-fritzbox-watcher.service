# Quelle: deploy/systemd/security-ai-fritzbox-watcher.service
# Stand: 2026-09-28 (Phase 3.8a)
# Bei Aenderungen: systemctl daemon-reload
#
# Nach Installation (Betriebsakt, nicht im Commit):
#   cp deploy/systemd/security-ai-fritzbox-watcher.service \
#      /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now security-ai-fritzbox-watcher.timer

[Unit]
Description=Fritz!Box-Watcher (device_presence/offline)
Documentation=file:/opt/security-ai/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=security-ai
Group=security-ai
WorkingDirectory=/opt/security-ai
EnvironmentFile=/opt/security-ai/.env
ExecStart=/opt/security-ai/.venv/bin/python3 -m tools.fritzbox_watcher
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/opt/security-ai/audit-logs
ReadWritePaths=/opt/security-ai/data

[Install]
WantedBy=multi-user.target
